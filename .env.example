# Copy to .env.local. Use your own Supabase project or `pnpm supabase status`.

# --- Public: inlined into the browser bundle at build time. Never secrets. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-or-local-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only. No NEXT_PUBLIC_ prefix on any of these. ---

# Comma-separated emails allowed to register as lecturers. Seeded into the
# lecturer_allowlist table by `pnpm seed:allowlist`; the table is the source of
# truth at runtime, this variable only populates it.
LECTURER_ALLOWLIST=replace-with-a-commas-separated-list-of-emails

# Local video, captions, and source files. This directory is ignored by Git.
MEDIA_ROOT=./media

# Class-visible transcript Q&A uses OpenAI when configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
