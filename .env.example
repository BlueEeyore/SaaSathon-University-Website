# Copy to .env.local. Use your own Supabase project or `pnpm supabase status`.

# --- Public: inlined into the browser bundle at build time. Never secrets. ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-or-local-anon-key

# --- Server-only. No NEXT_PUBLIC_ prefix on any of these. ---

# Comma-separated emails allowed to register as lecturers. Seeded into the
# lecturer_allowlist table by `pnpm seed:allowlist`; the table is the source of
# truth at runtime, this variable only populates it.
LECTURER_ALLOWLIST=replace-with-a-commas-separated-list-of-emails

# Demo-only fast sign-in. Off unless set to 1. Never enable on a public URL.
DEMO_QUICK_LOGIN=0
# Password for the seeded demo accounts. Server-only; the quick-login action
# performs a real password sign-in and is not an authentication bypass.
DEMO_LOGIN_PASSWORD=replace-with-a-local-only-demo-password

# Where normalised video, captions and source uploads live. Outside the repo.
MEDIA_ROOT=./media

# Transcription worker (Phase 2). The mock provider is used when unset, so
# development and tests never require the worker to be running.
TRANSCRIBER_URL=
TRANSCRIBER_MODEL=base

# Phase 2 AI features only. The demo spine never calls OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=replace-with-a-model-id

# Service-role key. Used ONLY by the transcription worker process, never by the
# Next.js app or the browser. Leave blank in .env.local for app development.
WORKER_SUPABASE_SERVICE_ROLE_KEY=
